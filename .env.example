VITE_SUPABASE_ANON_KEY=

# Sentry (frontend)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Sentry (build - source maps upload, solo en CI)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=stryv-studio
SENTRY_PROJECT=ekko-studio

# Stripe (público, se mete en Fase 3)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe (privado, solo Netlify Functions, se mete en Fase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase service role (solo Netlify Functions, NUNCA cliente)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret para firmar tokens QR (se mete en Fase 2)
QR_JWT_SECRET=

# Planes STRYV (EKKO-149): lo que STRYV le cobra al estudio en la cuenta de la
# plataforma (misma STRIPE_SECRET_KEY de arriba). Opcionales: precio mensual en
# centavos MXN de cada plan; sin definir o inválido = el default.
#   STRYV Care (mantenimiento e infraestructura): default 250000 ($2,500)
#   STRYV Grow (videos con IA para redes):        default 650000 ($6,500)
STRYV_CARE_CENTAVOS=
STRYV_GROW_CENTAVOS=
